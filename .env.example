# Copy to .env.local for local development. On Netlify (GitHub builds), add these under
# Site configuration > Environment variables instead.

# Supabase (the anon key is public by design; row-level security protects the data)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Public origin where cards live, used for QR codes and share links
VITE_PUBLIC_ORIGIN=https://selloapp.netlify.app

# Stripe keys do NOT go here. Payments run on Supabase Edge Functions
# (supabase/functions); their secrets live in Supabase > Edge Functions > Secrets.
